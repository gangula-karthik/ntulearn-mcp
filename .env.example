# All values are optional. The defaults work for most users.
# Set them only to override the defaults — see README for details.

# Manual BbRouter cookie value (starts with "expires:"). The server resolves
# the cookie from: NTULEARN_COOKIE env -> config file -> read-only Firefox
# cookies.sqlite. Better: run `ntulearn-mcp setup` once and let it capture +
# validate the cookie live and store it in the config file.
#NTULEARN_COOKIE=expires:1234567890,id:...

# Base URL for your Blackboard Learn instance (defaults to NTU Singapore).
#NTULEARN_BASE_URL=https://ntulearn.ntu.edu.sg

# Where download_file/download_course save files (relative to where the server runs).
#NTULEARN_DOWNLOAD_DIR=./downloads
